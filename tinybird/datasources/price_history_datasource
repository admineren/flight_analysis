SCHEMA >
    `origin` String,
    `destination` String,
    `departure_date` String,
    `return_date` String DEFAULT '',
    `airline` String,
    `price` Float64,
    `currency` String DEFAULT 'TRY',
    `source` String,
    `observed_at` DateTime

ENGINE "ReplacingMergeTree"
ENGINE_SORTING_KEY "origin, destination, departure_date, return_date, observed_at"
