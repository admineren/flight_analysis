TOKEN price_ingest_token APPEND

SCHEMA >
    `passport` String `json:$.passport`,
    `origin` String `json:$.origin`,
    `destination` String `json:$.destination`,
    `departure_date` String `json:$.departure_date`,
    `return_date` String `json:$.return_date`,
    `airline` String `json:$.airline`,
    `price` Float64 `json:$.price`,
    `currency` String `json:$.currency`,
    `price_level` String `json:$.price_level`,
    `typical_price` Float64 `json:$.typical_price`,
    `vs_typical_pct` Int32 `json:$.vs_typical_pct`,
    `duration_hours` Float64 `json:$.duration_hours`,
    `stops` Int32 `json:$.stops`,
    `visa_color` String `json:$.visa_color`,
    `visa_name` String `json:$.visa_name`,
    `visa_duration` String `json:$.visa_duration`,
    `booking_url` String `json:$.booking_url`,
    `source` String `json:$.source`,
    `observed_at` DateTime `json:$.observed_at`

ENGINE "ReplacingMergeTree"
ENGINE_SORTING_KEY "passport, origin, destination, departure_date, return_date, observed_at"

FORWARD_QUERY >
    SELECT
        '' AS passport,
        origin,
        destination,
        departure_date,
        return_date,
        airline,
        price,
        currency,
        price_level,
        0 AS typical_price,
        0 AS vs_typical_pct,
        duration_hours,
        stops,
        '' AS visa_color,
        '' AS visa_name,
        '' AS visa_duration,
        '' AS booking_url,
        source,
        observed_at
