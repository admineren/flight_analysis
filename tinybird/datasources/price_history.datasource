TOKEN price_ingest_token APPEND

SCHEMA >
    `origin` String `json:$.origin`,
    `destination` String `json:$.destination`,
    `departure_date` String `json:$.departure_date`,
    `return_date` String `json:$.return_date`,
    `airline` String `json:$.airline`,
    `price` Float64 `json:$.price`,
    `currency` String `json:$.currency`,
    `price_level` String `json:$.price_level`,       -- YENİ: low, typical, high
    `duration_hours` Float64 `json:$.duration_hours`, -- YENİ: Uçuş süresi
    `stops` Int32 `json:$.stops`,                     -- YENİ: Aktarma sayısı
    `source` String `json:$.source`,
    `observed_at` DateTime `json:$.observed_at`

ENGINE "ReplacingMergeTree"
ENGINE_SORTING_KEY "origin, destination, departure_date, return_date, observed_at"
