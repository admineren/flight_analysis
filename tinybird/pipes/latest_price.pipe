TOKEN telegram_read_token READ

NODE latest
SQL >
%
    SELECT
        passport,
        origin,
        destination,
        departure_date,
        return_date,
        airline,
        price,
        currency,
        price_level,
        typical_price,
        vs_typical_pct,
        duration_hours,
        stops,
        layover_city,
        layover_hours,
        visa_color,
        visa_name,
        visa_duration,
        booking_url,
        source,
        observed_at
    FROM price_history
    ORDER BY observed_at DESC
    LIMIT 1 BY origin, destination, departure_date, return_date

TYPE ENDPOINT
